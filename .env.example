# Copy to .env and fill in. Never commit .env.
# Only GROQ_API_KEY is required to run the stack locally.

# ── Models ────────────────────────────────────────────────────────────────────
# Groq API key. Free tier is sufficient. https://console.groq.com/keys
GROQ_API_KEY=

# The model a prompt target runs against by default.
DEFAULT_TARGET_MODEL=qwen/qwen3.6-27b

# The judge. MUST be a different model family from DEFAULT_TARGET_MODEL — a model
# must never grade its own output. Asserted by a configuration test.
JUDGE_MODEL=openai/gpt-oss-120b

# ── Database ──────────────────────────────────────────────────────────────────
# Compose sets this for the api and worker services; override only to point at
# an external Postgres.
DATABASE_URL=postgresql+asyncpg://promptproof:promptproof@db:5432/promptproof
POSTGRES_USER=promptproof
POSTGRES_PASSWORD=promptproof
POSTGRES_DB=promptproof

# ── Scan execution ────────────────────────────────────────────────────────────
# Probes in flight per worker. Lower this if the provider rate-limits you.
SCAN_CONCURRENCY=4

# How long a worker's claim on a scan is honoured before another worker may
# reclaim it. Must exceed the longest realistic single-probe duration.
SCAN_LEASE_SECONDS=300

# Reclaims before a scan is marked failed instead of retried.
SCAN_MAX_ATTEMPTS=3

# Per-call timeout for target and judge requests, in seconds.
MODEL_TIMEOUT_SECONDS=60

# ── Telemetry ─────────────────────────────────────────────────────────────────
# Optional. Without these the app runs and emits nothing; it never fails because
# telemetry is unavailable.
LOGFIRE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=promptproof
ENVIRONMENT=local

# ── Security ──────────────────────────────────────────────────────────────────
# Allows endpoint targets to point at private address space and plain http.
# DEVELOPMENT ONLY. Production config asserts this is false.
SSRF_ALLOW_PRIVATE=false

# Shared secret the alert webhook must present to reach the on-call agent.
ONCALL_WEBHOOK_SECRET=

# Token the on-call agent uses to file issues. Needs issues:write and nothing else.
ONCALL_GITHUB_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
